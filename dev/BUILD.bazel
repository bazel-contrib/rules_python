load("@rules_multirun//:defs.bzl", "multirun")
load("//python/uv:lock.bzl", "lock")  # buildifier: disable=bzl-visibility

licenses(["notice"])

# Run bazel run //dev:uv_lock.update
lock(
    name = "uv_lock",
    srcs = ["pyproject.toml"],
    out = "uv.lock",
    python_version = "3.10",
    visibility = ["//:__subpackages__"],
)

# This target runs all dev-only dependency updaters across the repo.
# Run: bazel run //dev:all_requirements.update
multirun(
    name = "all_requirements.update",
    commands = [
        ":uv_lock.update",
        "//examples:bzlmod_other_module_uv_lock.update",
        "//examples:bzlmod_uv_lock.update",
        "//examples/wheel:requirements_server.update",
        "//tests/multi_pypi/alpha:requirements.update",
        "//tests/multi_pypi/beta:requirements.update",
        "//tests/multiple_inputs:multiple_inputs.update",
        "//tests/multiple_inputs:multiple_pyproject_toml.update",
        "//tests/multiple_inputs:multiple_requirements_in.update",
        "//tests/uv/lock/pyproject_toml:requirements.update",
        "//tests/uv/lock/workspaces:requirements.update",
        "//tools/publish:requirements.update",
    ],
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
)
