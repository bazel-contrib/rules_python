load("//python:py_library.bzl", "py_library")
load("//tests/support:support.bzl", "NOT_WINDOWS")

package(default_visibility = ["//tests/agents/pr_queue:__pkg__"])

exports_files(["index.html"])

# Sidecar targets POSIX IDE daemon/worktree conventions; exclude Windows builds.
_SIDECAR_COMPAT = NOT_WINDOWS

py_library(
    name = "fetch_pr_queue",
    srcs = ["fetch_pr_queue.py"],
    imports = ["."],
    target_compatible_with = _SIDECAR_COMPAT,
)

py_library(
    name = "state_store",
    srcs = ["state_store.py"],
    imports = ["."],
    target_compatible_with = _SIDECAR_COMPAT,
    deps = [":fetch_pr_queue"],
)

py_library(
    name = "ls_client",
    srcs = ["ls_client.py"],
    imports = ["."],
    target_compatible_with = _SIDECAR_COMPAT,
    deps = [
        ":fetch_pr_queue",
        ":state_store",
    ],
)

py_library(
    name = "git_worktree",
    srcs = ["git_worktree.py"],
    imports = ["."],
    target_compatible_with = _SIDECAR_COMPAT,
    deps = [
        ":fetch_pr_queue",
        ":ls_client",
        ":state_store",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    data = ["index.html"],
    imports = ["."],
    target_compatible_with = _SIDECAR_COMPAT,
    deps = [
        ":fetch_pr_queue",
        ":git_worktree",
        ":ls_client",
        ":state_store",
    ],
)
