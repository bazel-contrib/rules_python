load("@rules_python//python:py_library.bzl", "py_library")

package(
    default_visibility = ["//sphinxdocs:__subpackages__"],
)

# NOTE: This provides the library on its own, not its dependencies.
# The caller provides Sphinx and Docutils dependencies at runtime, so static
# type checking without deps in the library target fails import resolution.
py_library(
    name = "sphinx_bzl",
    srcs = glob(["*.py"]),
    imports = [".."],
    tags = ["no-pyrefly"],
    # Allow depending on it in sphinx_binary targets
    visibility = ["//visibility:public"],
)
