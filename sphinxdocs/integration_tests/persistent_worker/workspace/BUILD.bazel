load("@sphinxdocs//sphinxdocs:sphinx.bzl", "sphinx_build_binary", "sphinx_docs")

# Exposes workspace config files as test data for
# //tests/bazelci:downloader_config_test.
filegroup(
    name = "workspace_configs",
    srcs = [
        ".bazelrc",
        "MODULE.bazel",
        "WORKSPACE",
    ],
    visibility = ["//visibility:public"],
)

sphinx_docs(
    name = "docs",
    srcs = glob(["*.md"]),
    config = "conf.py",
    formats = ["html"],
    sphinx = ":sphinx-build",
)

sphinx_build_binary(
    name = "sphinx-build",
    deps = [
        "@dev_pip//myst_parser",
        "@dev_pip//sphinx",
    ],
)
