genrule(
    name = "stdlib_shadowing_outputs",
    outs = [
        "shutil.py",
        "types.py",
    ],
    cmd = """
cat > $(@D)/shutil.py <<'PY'
raise RuntimeError("target output shutil.py shadowed the stdlib shutil module")
PY
cat > $(@D)/types.py <<'PY'
raise RuntimeError("target output types.py shadowed the stdlib types module")
PY
""",
)

