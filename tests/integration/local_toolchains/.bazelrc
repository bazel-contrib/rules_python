startup --windows_enable_symlinks
common --action_env=RULES_PYTHON_BZLMOD_DEBUG=1
common --repo_env=RULES_PYTHON_BZLMOD_DEBUG=1
common --lockfile_mode=off
test --test_output=errors
# Windows requires these for multi-python support:
build --enable_runfiles
common:bazel7.x --incompatible_python_disallow_native_rules
build --//:py=local
common --announce_rc

# TODO: Delete before merging; see the root .bazelrc.
common --registry=https://bazel-contrib.github.io/rules_runfiles_group --registry=https://bcr.bazel.build
