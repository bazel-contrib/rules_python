load("//:probe.bzl", "check", "probe")

config_setting(
    name = "py311",
    flag_values = {"@rules_python//python/config_settings:python_version": "3.11"},
)

config_setting(
    name = "py312",
    flag_values = {"@rules_python//python/config_settings:python_version": "3.12"},
)

probe(
    name = "tool",
    value = select({
        ":py310": "3.10",
        ":py311": "3.11",
        ":py312": "3.12",
        "//conditions:default": "unexpected",
    }),
)

probe(
    name = "binding",
    tool = ":tool",
    value = select({
        ":py310": "3.10",
        ":py311": "3.11",
        ":py312": "3.12",
        "//conditions:default": "unexpected",
    }),
    deps = ["//native:core"],
)

check(
    name = "check311",
    native_version = "3.10",
    target = ":binding",
    version = "3.11",
)

check(
    name = "check312",
    native_version = "3.10",
    target = ":binding",
    version = "3.12",
)

config_setting(
    name = "py310",
    flag_values = {"@rules_python//python/config_settings:python_version": "3.10"},
)
