load("//python:py_test.bzl", "py_test")
load("//tests/support:support.bzl", "SUPPORTS_BZLMOD")

py_test(
    name = "whl_library_extras_test",
    srcs = ["whl_library_extras_test.py"],
    target_compatible_with = SUPPORTS_BZLMOD,
    deps = [
        "@whl_library_extras_direct_dep//:[optional]",
    ],
)

py_test(
    name = "whl_library_requested_extras_test",
    srcs = ["whl_library_extras_test.py"],
    main = "whl_library_extras_test.py",
    target_compatible_with = SUPPORTS_BZLMOD,
    deps = [
        # The `pkg` target includes the extras from the `requirement`.
        "@whl_library_extras_direct_dep//:pkg",
    ],
)

py_test(
    name = "whl_library_no_extras_test",
    srcs = ["whl_library_no_extras_test.py"],
    target_compatible_with = SUPPORTS_BZLMOD,
    deps = [
        "@whl_library_extras_direct_dep//:[]",
        # The extra that the package does not provide is the same as the
        # package without extras.
        "@whl_library_extras_direct_dep//:[unknown]",
        # The same for the extra that is only requested in the hub config.
        "@whl_library_extras_direct_dep//:[nope]",
    ],
)

py_test(
    name = "whl_library_transitive_extras_test",
    srcs = ["whl_library_transitive_extras_test.py"],
    target_compatible_with = SUPPORTS_BZLMOD,
    deps = [
        # The METADATA of the consumer requires `pkg[optional]`, which is not
        # requested in the hub, and `pkg[unknown]`, which `pkg` does not
        # provide.
        "@whl_library_extras_consumer//:pkg",
    ],
)
