load("//python:pip.bzl", "whl_filegroup")
load("//python:py_binary.bzl", "py_binary")
load("//python:py_library.bzl", "py_library")
load("//python:py_test.bzl", "py_test")
load("//python/private/pypi:py_sdist_wheel.bzl", "py_sdist_wheel")  # buildifier: disable=bzl-visibility
load(":py_sdist_wheel_bzl_tests.bzl", "py_sdist_wheel_bzl_test_suite")

py_sdist_wheel_bzl_test_suite(
    name = "py_sdist_wheel_bzl_tests",
)

py_binary(
    name = "make_test_sdist",
    srcs = ["make_test_sdist.py"],
    main = "make_test_sdist.py",
)

genrule(
    name = "gen_demo_sdist",
    outs = ["sdist_demo-0.5.0.tar.gz"],
    cmd = "$(execpath :make_test_sdist) $@",
    tools = [":make_test_sdist"],
)

py_library(
    name = "classic_bdep",
    srcs = ["classic_bdep/site-packages/classic_bdep/__init__.py"],
    data = ["classic_bdep/site-packages/classic_bdep-1.0.dist-info/METADATA"],
    imports = ["classic_bdep/site-packages"],
)

py_library(
    name = "custom_build_helper",
    srcs = ["custom_build_helper/helper_mod.py"],
    data = ["custom_build_helper/helper_data.txt"],
    imports = ["custom_build_helper"],
)

py_library(
    name = "custom_shadow_dep",
    srcs = ["custom_shadow_dep/packaging/__init__.py"],
    imports = ["custom_shadow_dep"],
)

py_sdist_wheel(
    name = "sdist_demo-0.5.0.whldir",
    build_deps = [
        ":classic_bdep",
        ":custom_build_helper",
        ":custom_shadow_dep",
    ],
    pre_build_patch_strips = [1],
    pre_build_patches = ["pre_build.patch"],
    sdist = ":gen_demo_sdist",
)

filegroup(
    name = "sdist_demo_whldir_fg",
    srcs = [":sdist_demo-0.5.0.whldir"],
    output_group = "whldir",
)

whl_filegroup(
    name = "sdist_demo_whl_fg",
    pattern = "sdist_demo/.*",
    whl = ":sdist_demo-0.5.0.whldir",
)

py_sdist_wheel(
    name = "sdist_demo_bare_a",
    build_deps = [
        ":classic_bdep",
        ":custom_build_helper",
        ":custom_shadow_dep",
    ],
    sdist = ":gen_demo_sdist",
)

py_sdist_wheel(
    name = "sdist_demo_bare_b",
    build_deps = [
        ":classic_bdep",
        ":custom_build_helper",
        ":custom_shadow_dep",
    ],
    sdist = ":gen_demo_sdist",
)

genrule(
    name = "gen_cext_sdist",
    outs = ["sdist_cext-0.1.0.tar.gz"],
    cmd = "$(execpath :make_test_sdist) --c-ext $@",
    tools = [":make_test_sdist"],
)

py_sdist_wheel(
    name = "sdist_cext_a.whldir",
    sdist = ":gen_cext_sdist",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "sdist_cext_a_whldir_fg",
    srcs = [":sdist_cext_a.whldir"],
    output_group = "whldir",
)

py_sdist_wheel(
    name = "sdist_cext_b.whldir",
    sdist = ":gen_cext_sdist",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "sdist_cext_b_whldir_fg",
    srcs = [":sdist_cext_b.whldir"],
    output_group = "whldir",
)

py_test(
    name = "sdist_cext_test",
    size = "small",
    srcs = ["sdist_cext_test.py"],
    data = [
        ":sdist_cext_a.whldir",
        ":sdist_cext_a_whldir_fg",
        ":sdist_cext_b.whldir",
        ":sdist_cext_b_whldir_fg",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//python/runfiles"],
)

py_test(
    name = "sdist_wheel_builder_test",
    size = "small",
    srcs = [
        "make_test_sdist.py",
        "sdist_wheel_builder_test.py",
    ],
    data = [
        ":sdist_demo-0.5.0.whldir",
        ":sdist_demo_bare_a",
        ":sdist_demo_bare_b",
        ":sdist_demo_whl_fg",
        ":sdist_demo_whldir_fg",
    ],
    main = "sdist_wheel_builder_test.py",
    deps = [
        "//python/private/pypi:sdist_wheel_builder_lib",
        "//python/runfiles",
    ],
)
