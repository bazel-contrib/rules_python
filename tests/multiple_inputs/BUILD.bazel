load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//python/uv:lock.bzl", "lock")

lock(
    name = "multiple_requirements_in",
    srcs = [
        "requirements_1.in",
        "requirements_2.in",
    ],
    out = "multiple_requirements_in.txt",
    # It seems that the CI remote executors for the RBE do not have network
    # connectivity due to current CI setup.
    tags = ["no-remote-exec"],
    visibility = ["//:__subpackages__"],
)

diff_test(
    name = "multiple_requirements_in_test",
    timeout = "short",
    file1 = ":multiple_requirements_in",
    file2 = "multiple_requirements_in.txt",
)

