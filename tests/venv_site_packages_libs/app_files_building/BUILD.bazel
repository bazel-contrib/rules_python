_PKGUTIL_INIT = "__path__ = __import__('pkgutil').extend_path(__path__, __name__)\n"

tree_venv_lib(
    name = "tree_venv_runtime_a",
    contents = {
        "site-packages/foo/__init__.py": "ORIGIN = 'tree_a'\n",
        "site-packages/foo/a.py": "VALUE = 'from_a'\n",
        "site-packages/foo/plugins/__init__.py": "",
        "site-packages/foo/plugins/shared.py": "WINNER = 'tree_a'\n",
        "site-packages/pkgutil_ns/__init__.py": _PKGUTIL_INIT,
        "site-packages/pkgutil_ns/one.py": "VALUE = 1\n",
    },
    namespace_package_files = ["site-packages/pkgutil_ns/__init__.py"],
    package = "tree-a",
)

tree_venv_lib(
    name = "tree_venv_runtime_b",
    contents = {
        "site-packages/foo/plugins/__init__.py": "",
        "site-packages/foo/plugins/b.py": "VALUE = 'from_b'\n",
        "site-packages/foo/plugins/shared.py": "WINNER = 'tree_b'\n",
        "site-packages/pkgutil_ns/__init__.py": _PKGUTIL_INIT,
        "site-packages/pkgutil_ns/two.py": "VALUE = 2\n",
    },
    namespace_package_files = ["site-packages/pkgutil_ns/__init__.py"],
    package = "tree-b",
)

py_reconfig_test(
    name = "tree_venv_merge_test",
