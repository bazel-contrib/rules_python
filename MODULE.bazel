bazel_dep(
    name = "rules_rust",
    version = "0.73.0",
    dev_dependency = TOOL_DEPS_DEV_ONLY,
)

rust_crates = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    dev_dependency = TOOL_DEPS_DEV_ONLY,
)
rust_crates.spec(
    package = "sha2",
    version = "0.10.8",
)

# The crates must build for every platform in dev/platforms. Conditional
# dependencies are resolved for these triples; rules_rust matches them by CPU
# and OS, e.g. i686-unknown-linux-gnu also matches the i686-unknown-linux-musl
# platform.
rust_crates.from_specs(
    cargo_lockfile = "//crates:Cargo.lock",
    lockfile = "//crates:Cargo.Bazel.lock",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabi",
        "i686-pc-windows-msvc",
        "i686-unknown-linux-gnu",
        "riscv64gc-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)

# rules_rust has no @rules_rust//rust/platform config_setting for Linux ppc64le,
# so don't mark the crates as incompatible with platforms that don't match one
# of the triples above. Such platforms get only the unconditional dependencies,
# which suffice for sha2.
rust_crates.render_config(
    generate_target_compatible_with = False,
)
use_repo(rust_crates, "crates")

