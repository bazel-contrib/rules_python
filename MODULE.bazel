bazel_dep(name = "rules_bazel_integration_test", version = "0.27.0", dev_dependency = True)
bazel_dep(name = "rules_testing", version = "0.6.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.3.0", dev_dependency = True)
bazel_dep(name = "rules_multirun", version = "0.9.0", dev_dependency = True)
bazel_dep(name = "bazel_ci_rules", version = "1.0.0", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.2.0", dev_dependency = True)

# Rust toolchains to cross-compile the release artifacts for other Linux CPUs
# from Linux x86_64; see dev/release_artifacts. They target musl, which Rust can
# link statically with its bundled rust-lld, so no C cross toolchain is needed.
rust = use_extension(
    "@rules_rust//rust:extensions.bzl",
    "rust",
    dev_dependency = True,
)
rust.repository_set(
    # rules_rust also registers an x86_64 to x86_64 toolchain from this set, in
    # name order with its default ones, so the name must sort after
    # rust_linux_x86_64 for the default x86_64 toolchain to take precedence.
    name = "rust_release_linux",
    # The default allocator library needs a C toolchain for the target platform,
    # but there isn't one. This one is what rules_rust uses for e.g. Windows.
    allocator_library = "@rules_rust//rust/private/cc:empty",
    edition = "2021",
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "//dev/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
    # rules_rust 0.73.0's default version; update it with rules_rust. The
    # default toolchain builds proc-macros, which rustc only loads if they were
    # built by the same version.
    versions = ["1.97.1"],
)

# Other targets for the same set; the first tag sets the shared attributes.
rust.repository_set(
    name = "rust_release_linux",
    target_compatible_with = [
        "@platforms//cpu:armv7",
        "@platforms//os:linux",
        "//dev/platforms:musl",
    ],
    target_triple = "armv7-unknown-linux-musleabihf",
)
rust.repository_set(
    name = "rust_release_linux",
    target_compatible_with = [
        "@platforms//cpu:x86_32",
        "@platforms//os:linux",
        "//dev/platforms:musl",
    ],
    target_triple = "i686-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_release_linux",
    target_compatible_with = [
        "@platforms//cpu:ppc64le",
        "@platforms//os:linux",
        "//dev/platforms:musl",
    ],
    target_triple = "powerpc64le-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_release_linux",
    target_compatible_with = [
        "@platforms//cpu:riscv64",
        "@platforms//os:linux",
        "//dev/platforms:musl",
    ],
    target_triple = "riscv64gc-unknown-linux-musl",
)
use_repo(
    rust,
    "rust_release_linux__aarch64-unknown-linux-musl__stable",
    "rust_release_linux__armv7-unknown-linux-musleabihf__stable",
    "rust_release_linux__i686-unknown-linux-musl__stable",
    "rust_release_linux__powerpc64le-unknown-linux-musl__stable",
    "rust_release_linux__riscv64gc-unknown-linux-musl__stable",
)

# Registered here so that they take precedence over rules_rust's default
# toolchains, e.g. its Linux x86_64 to aarch64 one also matches the aarch64
# musl platform.
register_toolchains(
    "@rust_release_linux__aarch64-unknown-linux-musl__stable//:toolchain",
    "@rust_release_linux__armv7-unknown-linux-musleabihf__stable//:toolchain",
    "@rust_release_linux__i686-unknown-linux-musl__stable//:toolchain",
    "@rust_release_linux__powerpc64le-unknown-linux-musl__stable//:toolchain",
    "@rust_release_linux__riscv64gc-unknown-linux-musl__stable//:toolchain",
    dev_dependency = True,
)

# Rust toolchains to cross-compile the release artifacts for 32-bit and Arm
# Windows from Windows x86_64, with MSVC's cross tools; the Arm one needs
# Visual Studio's optional ARM64 build tools. Unlike the Linux ones, they
# aren't registered here: no default toolchain targets these platforms from
# Windows x86_64, and rules_rust registers them.
rust.repository_set(
    # As above, its x86_64 toolchain's name must sort after the default one's.
    # On Windows, rules_rust names toolchains after a hash of the full name:
    # rw-1886791612 for this one, after rust_windows_x86_64's rw-1704990954.
    name = "rust_release_windows",
    edition = "2021",
    exec_triple = "x86_64-pc-windows-msvc",
    target_compatible_with = [
        "@platforms//cpu:x86_32",
        "@platforms//os:windows",
    ],
    target_triple = "i686-pc-windows-msvc",
    # See above.
    versions = ["1.97.1"],
)

# Another target for the same set; the first tag sets the shared attributes.
rust.repository_set(
    name = "rust_release_windows",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
    ],
    target_triple = "aarch64-pc-windows-msvc",
)

