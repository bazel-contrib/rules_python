load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//support:database"],
)

py_test(
    name = "consumer_test",
    srcs = ["consumer_test.py"],
    deps = [":conftest"],
)
