load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//python/private:distribution_filegroup.bzl", "distribution_filegroup")  # buildifier: disable=bzl-visibility

package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])

rust_library(
    name = "shrubbery_lib",
    srcs = ["src/lib.rs"],
    edition = "2024",
    deps = [
        "//crates/exe_zip_maker:exe_zip_maker_lib",
        "//crates/zip_main_maker:zip_main_maker_lib",
        "//crates/zipper:zipper_lib",
    ],
)

rust_binary(
    name = "shrubbery",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":shrubbery_lib"],
)

distribution_filegroup(
    name = "distribution",
)
