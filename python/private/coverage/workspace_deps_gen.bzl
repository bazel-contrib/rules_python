"""A dev-only repository rule to generate the `workspace_deps.bzl` file.

The WORKSPACE macros cannot read the `uv.lock` file, so the wheels that are
selected for each Python version and platform are written to a checked-in
`.bzl` file. This uses the same wheel selection code as the `pip.parse` bzlmod
extension.

Run `bazel run //dev/update_deps:update_coverage_workspace_deps` to update the
checked-in file.
"""

load("@toml.bzl", "toml")
load("//python:versions.bzl", "MINOR_MAPPING")
load("//python/private:repo_utils.bzl", "repo_utils")
load("//python/private:text_util.bzl", "render")
load("//python/private:version.bzl", "version")
load("//python/private/pypi:default_platforms.bzl", "default_platforms")
load("//python/private/pypi:hash.bzl", "hash")
load("//python/private/pypi:parse_requirements.bzl", "parse_requirements")
load("//python/private/pypi:pep508_env.bzl", "env")
load("//python/private/pypi:pep508_evaluate.bzl", "evaluate")
load("//python/private/pypi:platform.bzl", "platform")
load("//python/private/pypi:whl_repo_name.bzl", "whl_repo_name")

_HEADER = '''\
"""The coverage wheels for the WORKSPACE toolchains.

@generated by `bazel run //dev/update_deps:update_coverage_workspace_deps` from
the `uv.lock` file in this directory. DO NOT EDIT.
"""
'''

def _platforms(python_version):
    """Return the platforms to select the wheels for.

    Args:
        python_version: {type}`str` the full Python version.

    Returns:
        {type}`dict[str, struct]` the platforms.
    """
    ver = version.parse(python_version, strict = True)
    ret = {}
    for name, values in default_platforms().items():
        p = platform(**values)
        env_ = env(
            env = p.env,
            os = p.os_name,
            arch = p.arch_name,
            python_version = python_version,
        )
        if p.marker and not evaluate(p.marker, env = env_):
            continue

        ret[name] = struct(
            env = env_,
            whl_abi_tags = [
                tag.format(major = ver.release[0], minor = ver.release[1])
                for tag in p.whl_abi_tags
            ],
            whl_platform_tags = p.whl_platform_tags,
        )
    return ret

def _workspace_deps_gen_impl(rctx):
    logger = repo_utils.logger(rctx)

    wheels = {}
    tools = {}
    for minor_version, full_version in sorted(
        MINOR_MAPPING.items(),
        key = lambda x: version.parse(x[0]).key(),
    ):
        platforms = _platforms(full_version)
        requirements = parse_requirements(
            rctx,
            platforms = platforms,
            uv_lock = rctx.attr.uv_lock,
            toml_decode = toml.decode,
            logger = logger,
        )
        for whl in requirements:
            if whl.name != "coverage":
                continue

            for src in whl.srcs:
                name = whl_repo_name(src.filename, src.digest)
                wheels[name] = {
                    "filename": src.filename,
                    "integrity": hash.integrity(src.digest),
                    "requirement": src.requirement_line,
                    "url": src.url,
                }
                for p in src.target_platforms:
                    tools.setdefault(minor_version, {})[p] = name

    rctx.file("BUILD.bazel", 'exports_files(["workspace_deps.bzl"])\n')
    rctx.file("workspace_deps.bzl", "\n".join([
        _HEADER,
        "COVERAGE_WHEELS = " + render.dict_dict(
            {k: wheels[k] for k in sorted(wheels)},
        ),
        "",
        "COVERAGE_TOOLS = " + render.dict_dict(
            {
                minor_version: {p: tools[minor_version][p] for p in sorted(tools[minor_version])}
                for minor_version in sorted(tools)
            },
        ),
        "",
    ]))

workspace_deps_gen = repository_rule(
    implementation = _workspace_deps_gen_impl,
    attrs = {
        "uv_lock": attr.label(mandatory = True, allow_single_file = True),
    },
    doc = "Generate the `workspace_deps.bzl` file from the coverage `uv.lock` file.",
)
