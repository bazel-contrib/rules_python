load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//python/private:distribution_filegroup.bzl", "distribution_filegroup")
load("//python/uv:lock.bzl", "lock")
load("//python/uv:vendor_uv_lock.bzl", "vendor_uv_lock")

package(default_visibility = ["//:__subpackages__"])

# The `uv_lock.bzl` file is generated by `vendor_uv_lock` below.
# gazelle:exclude uv_lock.bzl

exports_files(["uv.lock"])

distribution_filegroup(
    name = "distribution",
)

bzl_library(
    name = "coverage_workspace",
    srcs = ["coverage_workspace.bzl"],
    deps = [
        ":uv_lock",
        "//python:versions",
        "//python/private:bazel_tools",
        "//python/private:text_util",
        "//python/private:version",
        "//python/private/pypi:default_platforms",
        "//python/private/pypi:hash",
        "//python/private/pypi:parse_requirements",
        "//python/private/pypi:pep508_env",
        "//python/private/pypi:pep508_evaluate",
        "//python/private/pypi:platform",
        "//python/private/pypi:whl_repo_name",
    ],
)

# Run `bazel run //python/private/coverage:requirements.update` to update the
# `uv.lock` file.
lock(
    name = "requirements",
    srcs = ["pyproject.toml"],
    out = "uv.lock",
    args = [
        "--upgrade",  # always upgrade
    ],
)

# The WORKSPACE toolchains read the `uv.lock` from the vendored `uv_lock.bzl`.
# Run `bazel run //python/private/coverage:uv_lock_bzl.update` to update both.
vendor_uv_lock(
    name = "uv_lock_bzl",
    out = "uv_lock.bzl",
    lock = "requirements",
)

# keep
bzl_library(
    name = "uv_lock",
    srcs = ["uv_lock.bzl"],
)
