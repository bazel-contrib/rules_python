"""A WORKSPACE repository rule for installing PyPI dependencies from uv.lock."""

load("@bazel_skylib//lib:sets.bzl", "sets")
load("@toml.bzl", "toml")
load("//python/private:full_version.bzl", "full_version")
load("//python/private:normalize_name.bzl", "normalize_name")
load("//python/private:repo_utils.bzl", "REPO_DEBUG_ENV_VAR", "repo_utils")
load("//python/private:text_util.bzl", "render")
load(":attrs.bzl", COMMON_ATTRS = "ATTRS")
load(":parse_requirements.bzl", "parse_requirements")
load(":pep508_env.bzl", "env")
load(":pip_repository.bzl", "use_isolated")
load(":pip_repository_attrs.bzl", "ATTRS")
load(":pypi_repo_utils.bzl", "pypi_repo_utils")
load(":render_pkg_aliases.bzl", "render_pkg_aliases")
load(":whl_repo_name.bzl", "pypi_repo_name", "whl_repo_name")

_DEFAULT_PLATFORMS = {
    "linux_aarch64": struct(
        arch_name = "aarch64",
        constraints = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
        os_name = "linux",
        whl_platform_tags = ["linux_aarch64", "manylinux_*_aarch64"],
    ),
    "linux_x86_64": struct(
        arch_name = "x86_64",
        constraints = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
        os_name = "linux",
        whl_platform_tags = ["linux_x86_64", "manylinux_*_x86_64"],
    ),
    "osx_aarch64": struct(
        arch_name = "aarch64",
        constraints = ["@platforms//os:osx", "@platforms//cpu:aarch64"],
        os_name = "osx",
        whl_platform_tags = ["macosx_*_universal2", "macosx_*_arm64"],
    ),
    "osx_x86_64": struct(
        arch_name = "x86_64",
        constraints = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
        os_name = "osx",
        whl_platform_tags = ["macosx_*_universal2", "macosx_*_x86_64"],
    ),
    "windows_x86_64": struct(
        arch_name = "x86_64",
        constraints = ["@platforms//os:windows", "@platforms//cpu:x86_64"],
        os_name = "windows",
        whl_platform_tags = ["win_amd64"],
    ),
}

_BUILD_FILE_TEMPLATE = """\
package(default_visibility = ["//visibility:public"])

# Ensure the `requirements.bzl` source can be accessed by stardoc, since users load() from it
exports_files({exports})
"""

_REQUIREMENTS_BZL_TEMPLATE = """\
\"\"\"Starlark representation of locked requirements.

@generated by rules_python uv_lock.
\"\"\"

load("@rules_python//python:pip.bzl", "pip_utils")
load("@rules_python//python/pip_install:pip_repository.bzl", "whl_library")

all_requirements = {all_requirements}

all_whl_requirements_by_package = {all_whl_requirements_by_package}

all_whl_requirements = all_whl_requirements_by_package.values()

all_data_requirements = {all_data_requirements}

_packages = {packages}

_config = {config}

def _clean_name(name):
    return pip_utils.normalize_name(name)

def requirement(name):
    return "@{hub}//{{}}:pkg".format(_clean_name(name))

def whl_requirement(name):
    return "@{hub}//{{}}:whl".format(_clean_name(name))

def data_requirement(name):
    return "@{hub}//{{}}:data".format(_clean_name(name))

def dist_info_requirement(name):
    return "@{hub}//{{}}:dist_info".format(_clean_name(name))

def entry_point(pkg, script = None):
    if not script:
        script = pkg
    return "@{hub}//{{}}:rules_python_wheel_entry_point_{{}}".format(
        _clean_name(pkg),
        script,
    )

def install_deps(**whl_library_kwargs):
    whl_config = dict(_config)
    whl_config.update(whl_library_kwargs)
    for name, kwargs in _packages.items():
        whl_library(
            name = name,
            **(whl_config | kwargs)
        )
"""

def _get_python_interpreter_attr(rctx):
    if rctx.attr.python_interpreter:
        return rctx.attr.python_interpreter
    if "win" in rctx.os.name:
        return "python.exe"
    return "python3"

def _parse_major_minor(version_str):
    parts = version_str.split(".")
    major = parts[0] if len(parts) > 0 else "3"
    minor = parts[1] if len(parts) > 1 else "11"
    return major, minor

def _platforms_for_python_version(python_version):
    major, minor = _parse_major_minor(python_version)
    abi_tags = ["none", "abi3", "cp{}{}".format(major, minor)]
    return {
        plat_name: struct(
            env = env(
                os = meta.os_name,
                arch = meta.arch_name,
                python_version = python_version,
            ),
            whl_abi_tags = abi_tags,
            whl_platform_tags = ["any"] + meta.whl_platform_tags,
        )
        for plat_name, meta in _DEFAULT_PLATFORMS.items()
    }

def _render_uv_lock_config_build(is_multi_version, version_entries, rules_python_repo):
    lines = [
        'package(default_visibility = ["//:__subpackages__"])',
    ]
    for plat_name, meta in sorted(_DEFAULT_PLATFORMS.items()):
        lines.extend([
            "",
            "config_setting(",
            '    name = "is_{}",'.format(plat_name),
            "    constraint_values = {},".format(repr(meta.constraints)),
            ")",
        ])
    if is_multi_version:
        for entry in version_entries:
            py_nodot = entry.py_nodot
            for plat_name, meta in sorted(_DEFAULT_PLATFORMS.items()):
                lines.extend([
                    "",
                    "config_setting(",
                    '    name = "is_cp{}_{}",'.format(py_nodot, plat_name),
                    "    constraint_values = {},".format(repr(meta.constraints)),
                    "    flag_values = {",
                    '        "@{rules_python}//python/config_settings:python_version_major_minor": "{py_key}",'.format(
                        rules_python = rules_python_repo,
                        py_key = entry.key,
                    ),
                    "    },",
                    ")",
                ])
    lines.append("")
    return "\n".join(lines)

def _build_version_entries(rctx):
    if rctx.attr.python_interpreter_targets:
        versions = rctx.attr.python_versions or sorted(rctx.attr.python_interpreter_targets.keys())
        entries = []
        for py_ver in versions:
            if py_ver not in rctx.attr.python_interpreter_targets:
                fail("Missing python_interpreter_target for Python version {} in '{}'".format(
                    py_ver,
                    rctx.attr.name,
                ))
            full_ver = full_version(
                version = py_ver,
                minor_mapping = rctx.attr.minor_mapping,
            )
            major, minor = _parse_major_minor(full_ver)
            entries.append(struct(
                key = py_ver,
                py_nodot = "{}{}".format(major, minor),
                full_version = full_ver,
                interpreter_target = rctx.attr.python_interpreter_targets[py_ver],
            ))
        return entries, True

    py_exec = pypi_repo_utils.resolve_python_interpreter(
        rctx,
        python_interpreter = rctx.attr.python_interpreter,
        python_interpreter_target = rctx.attr.python_interpreter_target,
    )
    res = repo_utils.execute_checked(
        rctx,
        op = "GetPythonVersion",
        arguments = [py_exec, "-c", "import sys; print(sys.version.split()[0])"],
    )
    detected_version = res.stdout.strip().splitlines()[-1]
    major, minor = _parse_major_minor(detected_version)
    interp_target = str(rctx.attr.python_interpreter_target) if rctx.attr.python_interpreter_target else ""
    return [
        struct(
            key = "{}.{}".format(major, minor),
            py_nodot = "{}{}".format(major, minor),
            full_version = detected_version,
            interpreter_target = interp_target,
        ),
    ], False

def build_uv_lock_hub_packages(
        parsed_by_version,
        *,
        hub_name,
        is_multi_version = False,
        default_version = "",
        annotation_labels = None,
        requirement_cycles = None):
    """Build per-wheel `whl_library` kwargs and hub `pkg_aliases` maps.

    Args:
        parsed_by_version: {type}`list[tuple[struct, list[struct]]]` Pairs of
            `(version_entry, parsed_whls)` where each `version_entry` has fields
            `key`, `py_nodot`, `full_version`, and `interpreter_target`.
        hub_name: {type}`str` Name of the generated PyPI hub repository.
        is_multi_version: {type}`bool` Whether multiple Python versions are configured.
        default_version: {type}`str` Optional default Python version (`X.Y`).
        annotation_labels: {type}`dict[str, str] | None` Optional map from normalized
            package name to hub annotation file label.
        requirement_cycles: {type}`dict[str, list[str]] | None` Optional map from
            normalized cycle group name to normalized member package names.

    Returns:
        `struct(packages = dict, aliases = dict, bzl_packages = list[str])`.
    """
    annotation_labels = annotation_labels or {}
    requirement_cycles = requirement_cycles or {}
    group_by_whl = {
        whl_name: group_name
        for group_name, group_whls in requirement_cycles.items()
        for whl_name in group_whls
    }
    packages = {}
    pkg_alias_maps = {}
    exposed_pkgs = {}
    all_target_platforms = sorted(_DEFAULT_PLATFORMS.keys())

    for entry, parsed_whls in parsed_by_version:
        for whl in parsed_whls:
            if not whl.srcs:
                continue
            if whl.is_exposed:
                exposed_pkgs[whl.name] = None
            alias_map = pkg_alias_maps.setdefault(whl.name, {})
            for src in whl.srcs:
                if src.filename:
                    repo_suffix = whl_repo_name(src.filename, src.digest)
                else:
                    repo_suffix = pypi_repo_name(whl.name)
                if is_multi_version:
                    spoke_name = "{}_{}_{}".format(hub_name, entry.py_nodot, repo_suffix)
                else:
                    spoke_name = "{}_{}".format(hub_name, repo_suffix)

                if spoke_name not in packages:
                    kwargs = {}
                    if src.filename and src.filename.endswith(".whl") and src.url:
                        kwargs["filename"] = src.filename
                        kwargs["requirement"] = src.requirement_line
                        kwargs["urls"] = [src.url]
                        if src.digest:
                            algo, _, hex_digest = src.digest.partition(":")
                            if algo == "sha256" and hex_digest:
                                kwargs["sha256"] = hex_digest
                    else:
                        req_line = src.requirement_line
                        if src.digest:
                            req_line = "{} --hash={}".format(req_line, src.digest)
                        kwargs["requirement"] = req_line

                    if entry.interpreter_target:
                        kwargs["python_interpreter_target"] = entry.interpreter_target
                    ann_label = annotation_labels.get(whl.name)
                    if ann_label:
                        kwargs["annotation"] = ann_label
                    group_name = group_by_whl.get(whl.name)
                    if group_name:
                        kwargs["group_name"] = group_name
                        kwargs["group_deps"] = requirement_cycles[group_name]
                    packages[spoke_name] = kwargs

                for plat in src.target_platforms:
                    if is_multi_version:
                        cfg_label = "//_config:is_cp{}_{}".format(entry.py_nodot, plat)
                        alias_map.setdefault(cfg_label, spoke_name)
                        if default_version and entry.key == default_version:
                            alias_map.setdefault("//_config:is_{}".format(plat), spoke_name)
                    else:
                        alias_map.setdefault("//_config:is_{}".format(plat), spoke_name)

    aliases = {}
    for pkg_name, alias_map in sorted(pkg_alias_maps.items()):
        if not alias_map:
            continue
        unique_repos = {repo: None for repo in alias_map.values()}
        if not is_multi_version and len(unique_repos) == 1 and len(alias_map) == len(all_target_platforms):
            aliases[pkg_name] = unique_repos.keys()[0]
        else:
            aliases[pkg_name] = alias_map

    return struct(
        packages = packages,
        aliases = aliases,
        bzl_packages = sorted(exposed_pkgs.keys()),
    )

def render_uv_lock_repository(
        rctx,
        *,
        uv_lock,
        toml_decode):
    """Render a multi-platform WORKSPACE PyPI hub repository from `uv.lock`.

    Args:
        rctx: {type}`repository_ctx` Repository rule context.
        uv_lock: {type}`Label` Label of the `uv.lock` file to parse.
        toml_decode: {type}`callable` Function decoding TOML text into a dict.
    """
    logger = repo_utils.logger(rctx)
    hub_name = rctx.attr.name
    rules_python_repo = rctx.attr._rules_python_workspace.repo_name
    version_entries, is_multi_version = _build_version_entries(rctx)
    default_ver = rctx.attr.default_version

    # Normalize and write any per-package annotations into the hub repository.
    annotation_labels = {}
    exported_files = ["requirements.bzl"]
    extra_hub_aliases = {
        normalize_name(k): list(v)
        for k, v in rctx.attr.extra_hub_aliases.items()
    }
    for pkg, ann_json in rctx.attr.annotations.items():
        norm_pkg = normalize_name(pkg)
        ann_filename = "{}.annotation.json".format(norm_pkg)
        decoded = json.decode(ann_json)
        rctx.file(ann_filename, json.encode_indent(decoded))
        exported_files.append(ann_filename)
        annotation_labels[norm_pkg] = "@{}//:{}".format(hub_name, ann_filename)
        for exe_target in decoded.get("copy_executables", {}).keys():
            existing = extra_hub_aliases.setdefault(norm_pkg, [])
            if exe_target not in existing:
                existing.append(exe_target)

    parsed_by_version = []
    for entry in version_entries:
        parsed_whls = parse_requirements(
            rctx,
            extra_pip_args = rctx.attr.extra_pip_args,
            platforms = _platforms_for_python_version(entry.full_version),
            uv_lock = uv_lock,
            toml_decode = toml_decode,
            logger = logger,
        )
        parsed_by_version.append((entry, parsed_whls))

    # Normalize and validate requirement cycles before building package kwargs.
    raw_cycles = {
        name: sorted(sets.to_list(sets.make(deps)))
        for name, deps in rctx.attr.experimental_requirement_cycles.items()
    }
    for i in range(len(raw_cycles)):
        left_group = raw_cycles.keys()[i]
        left_deps = raw_cycles.values()[i]
        for j in range(len(raw_cycles) - (i + 1)):
            right_deps = raw_cycles.values()[1 + i + j]
            right_group = raw_cycles.keys()[1 + i + j]
            for d in left_deps:
                if d in right_deps:
                    fail("Error: Requirement %s cannot be repeated between cycles %s and %s; please merge the cycles." % (d, left_group, right_group))

    present_pkgs = {
        whl.name: None
        for _, parsed_whls in parsed_by_version
        for whl in parsed_whls
        if whl.srcs
    }
    requirement_cycles = {
        normalize_name(name): sorted([normalize_name(d) for d in group if normalize_name(d) in present_pkgs])
        for name, group in raw_cycles.items()
    }

    built = build_uv_lock_hub_packages(
        parsed_by_version,
        hub_name = hub_name,
        is_multi_version = is_multi_version,
        default_version = default_ver,
        annotation_labels = annotation_labels,
        requirement_cycles = requirement_cycles,
    )
    packages = built.packages
    aliases = built.aliases
    bzl_packages = built.bzl_packages
    all_pkg_names = sorted(aliases.keys())

    rctx.file(
        "BUILD.bazel",
        _BUILD_FILE_TEMPLATE.format(exports = repr(sorted(exported_files))),
    )
    rctx.file(
        "_config/BUILD.bazel",
        _render_uv_lock_config_build(
            is_multi_version = is_multi_version,
            version_entries = version_entries,
            rules_python_repo = rules_python_repo,
        ),
    )
    rctx.template(
        "config.bzl",
        rctx.attr._config_template,
        substitutions = {
            "%%PACKAGES%%": render.dict({p: None for p in all_pkg_names}),
        },
    )

    alias_files = render_pkg_aliases(
        aliases = aliases,
        requirement_cycles = requirement_cycles,
        extra_hub_aliases = extra_hub_aliases,
    )
    for path, contents in alias_files.items():
        rctx.file(path, contents)

    config = {
        "dep_template": "@{}//{{name}}:{{target}}".format(hub_name),
        "download_only": rctx.attr.download_only,
        "enable_implicit_namespace_pkgs": rctx.attr.enable_implicit_namespace_pkgs,
        "environment": rctx.attr.environment,
        "envsubst": rctx.attr.envsubst,
        "extra_pip_args": rctx.attr.extra_pip_args,
        "isolated": use_isolated(rctx, rctx.attr),
        "pip_data_exclude": rctx.attr.pip_data_exclude,
        "python_interpreter": _get_python_interpreter_attr(rctx),
        "quiet": rctx.attr.quiet,
        "repo": hub_name,
        "timeout": rctx.attr.timeout,
    }

    macro_tmpl = "@{}//{{}}:{{}}".format(hub_name)
    rctx.file(
        "requirements.bzl",
        _REQUIREMENTS_BZL_TEMPLATE.format(
            all_data_requirements = render.list([
                macro_tmpl.format(p, "data")
                for p in bzl_packages
            ]),
            all_requirements = render.list([
                macro_tmpl.format(p, "pkg")
                for p in bzl_packages
            ]),
            all_whl_requirements_by_package = render.dict({
                p: macro_tmpl.format(p, "whl")
                for p in bzl_packages
            }),
            config = render.dict(config),
            hub = hub_name,
            packages = render.dict(packages),
        ),
    )

def _uv_lock_repo_impl(rctx):
    render_uv_lock_repository(
        rctx,
        uv_lock = rctx.attr.uv_lock,
        toml_decode = toml.decode,
    )

uv_lock_repo = repository_rule(
    attrs = dict(
        annotations = attr.string_dict(
            doc = """
Optional annotations to apply to packages. Keys should be package names, with
capitalization matching the input lockfile, and values should be generated
using the `package_annotation` macro.
""",
        ),
        default_version = attr.string(
            doc = """
Optional default Python version (`X.Y`) when `python_interpreter_targets` is set.
""",
        ),
        experimental_requirement_cycles = ATTRS["experimental_requirement_cycles"],
        extra_hub_aliases = ATTRS["extra_hub_aliases"],
        minor_mapping = attr.string_dict(
            doc = """
Mapping from `X.Y` to `X.Y.Z` Python versions for multi-version hub aliases.
""",
        ),
        python_interpreter_targets = attr.string_dict(
            doc = """
Optional mapping from Python `X.Y` versions to host interpreter target label strings.
""",
        ),
        python_versions = attr.string_list(
            doc = """
Optional ordered list of Python `X.Y` versions when configuring multiple versions.
""",
        ),
        use_hub_alias_dependencies = ATTRS["use_hub_alias_dependencies"],
        uv_lock = attr.label(
            allow_single_file = True,
            mandatory = True,
            doc = """
A resolved `uv.lock` file containing the transitive set of dependencies.
""",
        ),
        _config_template = attr.label(
            default = ":config.bzl.tmpl",
        ),
        _rules_python_workspace = attr.label(
            default = Label("//:WORKSPACE"),
        ),
        **COMMON_ATTRS
    ),
    doc = """
Accepts a resolved `uv.lock` file and installs the dependencies listed within.
""",
    implementation = _uv_lock_repo_impl,
    environ = [
        "RULES_PYTHON_PIP_ISOLATED",
        REPO_DEBUG_ENV_VAR,
    ],
)
