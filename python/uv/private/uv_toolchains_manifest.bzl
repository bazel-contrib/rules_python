"""Fetch `uv` release manifests from a WORKSPACE file."""

load("//python/private:auth.bzl", "AUTH_ATTRS", "get_auth")
load(":dist_manifest.bzl", "DEFAULT_MANIFEST_FILENAME", "get_tool_urls_from_dist_manifest")
load(":uv_defaults.bzl", "DEFAULT_BASE_URL", "DEFAULT_VERSION")

_DIST_MANIFEST_BZL_TEMPLATE = """\
# Generated by @rules_python//python/uv/private:uv_toolchains_manifest.bzl
\"\"\"The `uv` release manifests fetched by `uv_toolchains_manifest(name = "{name}")`.\"\"\"

load("@rules_python//python/uv:repositories.bzl", _uv_register_toolchains = "uv_register_toolchains")

# The download `urls` and `sha256` of every `uv` archive in the manifests,
# keyed by version and then by platform triple.
DIST_MANIFESTS = {manifests}

def uv_register_toolchains(**kwargs):
    \"\"\"`uv_register_toolchains` of `@rules_python` with `manifests = DIST_MANIFESTS`.

    Args:
        **kwargs: the arguments of `uv_register_toolchains`; `manifests` given
            here are added to `DIST_MANIFESTS`.
    \"\"\"
    kwargs["manifests"] = DIST_MANIFESTS | (kwargs.get("manifests") or {{}})
    _uv_register_toolchains(**kwargs)
"""

def _generate_dist_manifest_bzl(
        rctx,
        *,
        name,
        versions,
        base_url,
        manifest_filename,
        netrc,
        auth_patterns,
        get_auth = get_auth):
    """Download the release manifests of `versions` and render `dist_manifest.bzl`.

    Args:
        rctx: {type}`repository_ctx` the context used to download and read the
            manifests.
        name: {type}`str` the repository name, for the generated docstring.
        versions: {type}`list[str]` the `uv` versions to fetch manifests for.
        base_url: {type}`str` the base URL of the `uv` releases.
        manifest_filename: {type}`str` the release manifest file name.
        netrc: {type}`str` the `.netrc` file for the downloads.
        auth_patterns: {type}`dict[str, str]` the auth patterns for the
            downloads.
        get_auth: the auth function to use.

    Returns:
        {type}`str` the `dist_manifest.bzl` content.
    """
    auth = {
        "auth_patterns": auth_patterns,
        "netrc": netrc,
    }
    auth = {k: v for k, v in auth.items() if v}

    manifests = {}
    for version in versions:
        sources = get_tool_urls_from_dist_manifest(
            rctx,
            base_url = "{}/{}".format(base_url, version),
            manifest_filename = manifest_filename,
            platforms = None,
            get_auth = get_auth,
            **auth
        )
        manifests[version] = {
            platform: {
                "sha256": source.sha256,
                "urls": source.urls,
            }
            for platform, source in sorted(sources.items())
        }

    return _DIST_MANIFEST_BZL_TEMPLATE.format(
        name = name,
        manifests = json.encode_indent(manifests, indent = "    "),
    )

def _uv_toolchains_manifest_impl(repository_ctx):
    repository_ctx.file("BUILD.bazel", "")
    repository_ctx.file("dist_manifest.bzl", _generate_dist_manifest_bzl(
        repository_ctx,
        name = repository_ctx.attr.name,
        versions = repository_ctx.attr.versions,
        base_url = repository_ctx.attr.base_url,
        manifest_filename = repository_ctx.attr.manifest_filename,
        netrc = repository_ctx.attr.netrc,
        auth_patterns = repository_ctx.attr.auth_patterns,
    ))

uv_toolchains_manifest = repository_rule(
    _uv_toolchains_manifest_impl,
    doc = """
Fetch the release manifests of `uv` versions in a WORKSPACE file.

The repository downloads the manifest of every version in `versions` and
writes `dist_manifest.bzl`, which has the download URLs and checksums of every
archive in them as `DIST_MANIFESTS`, and {obj}`uv_register_toolchains` bound to
them; load that to create and register the toolchains:

```starlark
load("@rules_python//python/uv:repositories.bzl", "uv_toolchains_manifest")

uv_toolchains_manifest(
    name = "uv_manifest",
    versions = ["0.13.5"],
)

load("@uv_manifest//:dist_manifest.bzl", "uv_register_toolchains")

uv_register_toolchains(name = "uv")
```

The manifests are read as-is: which platforms get a toolchain, and from which
archives, is decided by {obj}`uv_register_toolchains`. Versions released from
different places can be fetched with one repository each and combined with the
`manifests` argument of {obj}`uv_register_toolchains`.

:::{versionadded} VERSION_NEXT_FEATURE
:::
""",
    attrs = {
        "base_url": attr.string(
            doc = """
The base URL of the `uv` releases; the manifest of a version is downloaded from
`{base_url}/{version}/{manifest_filename}`. Defaults to the GitHub releases of
`uv`.
""",
            default = DEFAULT_BASE_URL,
        ),
        "manifest_filename": attr.string(
            doc = "The release manifest file name.",
            default = DEFAULT_MANIFEST_FILENAME,
        ),
        "versions": attr.string_list(
            doc = """
The `uv` versions to fetch the manifests of. Defaults to the version the
{obj}`uv` extension uses by default.
""",
            default = [DEFAULT_VERSION],
        ),
    } | AUTH_ATTRS,
)

testing = struct(
    generate_dist_manifest_bzl = _generate_dist_manifest_bzl,
)
