load("@rules_python//python/uv/private:lock.bzl", "lock")  # buildifier: disable=bzl-visibility

licenses(["notice"])  # Apache 2.0

lock(
    name = "bzlmod_uv_lock",
    srcs = ["bzlmod/pyproject.toml"],
    out = "bzlmod/uv.lock",
    directory = "examples/bzlmod",
    python_version = "3.10",
    visibility = ["//:__subpackages__"],
)

lock(
    name = "bzlmod_other_module_uv_lock",
    srcs = ["bzlmod/other_module/pyproject.toml"],
    out = "bzlmod/other_module/uv.lock",
    directory = "examples/bzlmod/other_module",
    python_version = "3.11",
    visibility = ["//:__subpackages__"],
)

# Exposes workspace config files as test data for
# //tests/bazelci:downloader_config_test.
filegroup(
    name = "workspace_configs",
    srcs = [
        "common.bazelrc",
    ] + glob(
        [
            "*/.bazelrc",
            "*/MODULE.bazel",
            "*/WORKSPACE",
            # Included so downloader_config_test detects stray configs if
            # added; allow_empty = True is needed because none exist under this
            # directory.
            "**/downloader_config.cfg",
        ],
        allow_empty = True,
    ),
    visibility = ["//tests:__subpackages__"],
)
