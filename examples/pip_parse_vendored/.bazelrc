test --test_output=errors

# Windows requires these for multi-python support:
build --enable_runfiles

# Vendoring requirements.bzl files isn't necessary under bzlmod
# When workspace support is dropped, this example can be removed.
common --noenable_bzlmod
common --enable_workspace
common --incompatible_python_disallow_native_rules
# Mitigate transient CI network failures via mirror fallback and retries.
common --experimental_downloader_config=downloader_config.cfg
common --http_timeout_scaling=10.0
common --experimental_repository_downloader_retries=10
